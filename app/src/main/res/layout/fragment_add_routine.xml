<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/textViewAddRoutineTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Añadir rutina"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/editTextRoutineName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre de la rutina"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/editTextRoutineDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Descripción"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/editTextRoutineDay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Día de la semana"
        android:inputType="text"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/buttonSaveRoutine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar rutina" />

</LinearLayout>